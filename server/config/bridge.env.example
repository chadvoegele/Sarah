# Example only. Not automatically loaded. Do not put real credentials here.
# Direct OpenAI-compatible model (default) or ACP agent.
SARAH_BACKEND=llm
# ACP requires absolute agent-side cwd and exactly one transport:
# SARAH_ACP_CWD=/work
# SARAH_ACP_SOCKET=/run/pi-acp/acp.sock
# SARAH_ACP_COMMAND='["pi-acp"]'
# SARAH_ACP_TIMEOUT_SECONDS=120
# Speech clock presentation timezone.
R1_TIMEZONE=UTC
# Optional local model paths; relative defaults are documented.
# R1_WHISPER_MODELS=/opt/sarah/models/whisper
# R1_KOKORO_ROOT=/opt/sarah/models/kokoro
# OpenAI-compatible API prefix; HTTP allowed only on loopback.
SARAH_LLM_BASE_URL=http://127.0.0.1:8012/v1
SARAH_LLM_MODEL=ggml-org/Qwen3.8-27B-GGUF:Q4_K_M
# Set only one token source. Both empty means no upstream Authorization header.
SARAH_LLM_API_KEY=
SARAH_LLM_API_KEY_FILE=
