# Example only; not automatically loaded. No credentials belong here.
# Optional; ACP is the only/default backend.
SARAH_BACKEND=acp
SARAH_ACP_CWD=/work
# Choose exactly one transport:
SARAH_ACP_SOCKET=/run/pi-acp/acp.sock
# SARAH_ACP_COMMAND='["pi-acp"]'
SARAH_ACP_TIMEOUT_SECONDS=120
# Existing speech configuration names remain compatible.
R1_TIMEZONE=UTC
# R1_WHISPER_MODELS=/opt/sarah/models/whisper
# R1_KOKORO_ROOT=/opt/sarah/models/kokoro
