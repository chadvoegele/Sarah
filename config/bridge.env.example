# Example only; not automatically loaded. No credentials belong in this file.
SARAH_BACKEND=acp
# Agent-side absolute workspace; it need not exist inside a socket-only bridge.
SARAH_ACP_CWD=/workspace
# Exactly one transport. Unix socket to an independently managed agent:
SARAH_ACP_SOCKET=/run/acp/agent.sock
# Or unset SOCKET and supply an administrator-selected argv array, never a shell:
# SARAH_ACP_COMMAND=["/opt/agent/bin/acp-agent","--stdio"]
SARAH_ACP_TIMEOUT_SECONDS=120
# Existing local assets only. Missing assets fail; runtime never downloads them.
R1_WHISPER_MODELS=/opt/speech/whisper
R1_KOKORO_ROOT=/opt/speech/kokoro
# Speech presentation of explicit timestamps only; never a local time-answer route.
R1_TIMEZONE=UTC
